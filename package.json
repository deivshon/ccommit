{
  "name": "ccommit",
  "scripts": {
    "build": "cargo build --release --locked",
    "test": "cargo test",
    "fmt": "cargo fmt --all && oxfmt",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "checklist": "pnpm lint && pnpm fmt && pnpm test && pnpm build",
    "fetch-gitmojis": "sh scripts/fetch-gitmojis.sh"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0"
  }
}
